{
  "name": "llm-docs",
  "version": "0.1.0",
  "description": "Local-first task memory for AI coding agents: durable task bundles, checkpoints, worktrees, MCP tools, hooks, and optional Jira import.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "llm-docs": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "ai",
    "cli",
    "documentation",
    "developer-tools",
    "llm",
    "agent",
    "mcp",
    "skills",
    "hooks",
    "task-memory",
    "context-engineering",
    "coding-agents",
    "jira",
    "git-worktree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pishikin/llm-docs.git"
  },
  "bugs": {
    "url": "https://github.com/pishikin/llm-docs/issues"
  },
  "homepage": "https://github.com/pishikin/llm-docs#readme",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^7.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "simple-git": "^3.36.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
